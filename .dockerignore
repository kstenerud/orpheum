# What `./staging` leaves out when it sends the repository to the image build (deploy/Containerfile,
# target runtime): state, tool downloads and build output. .git stays, so the binary records its
# commit (internal/platform/build).
.dev
.staging
.tools
bin
dist
orpheum
node_modules
**/node_modules
web/**/dist
web/**/.tsbuild
web/**/.vite
web/test-results
web/playwright-report
internal/core/webclient/dist/*
!internal/core/webclient/dist/.keep
# The gates' own trees and logs under .git, and agents' worktrees: about 2 GB the build copied into
# a new layer at every commit (caching-audit-2026-10-28.md, finding 7); the objects stay.
.git/revert-red
.git/check-pr
.git/worktrees
.git/gate-logs
.claude/worktrees
**/.dev
**/.tools
