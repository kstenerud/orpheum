# ABOUTME: Orpheum's image family (D235 §2): the development image, every tool the gates and the dev
# ABOUTME: loop need, and the runtime image staging and release run (D249), sharing one pinned base.
#
# Stages:
#   fetch      downloads the pinned FFmpeg, MKVToolNix, golangci-lint and sqlc with the
#              repository's own fetch scripts, which verify each download's SHA-256 (one way to
#              fetch them, AGENTS rule 11).
#   base       Debian and the pinned FFmpeg: what every image shares (D235 §2).
#   toolchain  base plus the pinned Go and Node: what building needs.
#   dev        toolchain plus the gate tools, Playwright's system libraries and a user whose uid
#              and gid are the host's, so files written in the bind-mounted repository are the
#              developer's own. `./dev` builds it (--target dev) and runs it.
#   build      toolchain plus the repository: `make build`, the binary with the web client in it.
#   runtime    base plus the binary, WireGuard's tools and a non-root user: the image staging and
#              release run as three services (D249 §2, internal/deployment/templates/compose.yaml). `./staging` builds it.
#
# `./dev` builds from the subset of the repository its stages copy (the same relative paths);
# `./staging` from the repository root, as .dockerignore trims it, with .git, so the binary says
# which commit it is.
#
# Every pin is written once. Go's version is go.mod's `toolchain` line, read at build time, and
# Node's major follows the Makefile's NODE_MAJOR; scripts/tests/test_dev_image.py fails when a
# checksum or Node drifts. golangci-lint's and sqlc's pins are scripts/fetch_tools.py's, so a
# Makefile edit rebuilds nothing here. Delve is not baked in: `make dev-debug` installs it on first
# use. Debian packages are verified by apt's signed archive, not pinned by version.

# debian:trixie-slim, the multi-arch index digest read from Docker Hub on 2026-10-30 (its openssl,
# pcre2 and liblzma security updates; research/security-pins-2026-10-30.md). Trixie is what the development NAS ran.
ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

# ---------------------------------------------------------------------------------------------
FROM ${DEBIAN_IMAGE} AS fetch
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/*
# The fetch scripts keep what they fetch under ORPHEUM_TOOLS_DIR instead of the repository's
# .tools/, so the tools baked in here are the ones `make ffmpeg` and the dev loop find later.
ENV ORPHEUM_TOOLS_DIR=/opt/orpheum/tools
COPY scripts/fetch_ffmpeg.py scripts/fetch_mkvtoolnix.py /opt/orpheum/scripts/
# MKVToolNix is pinned for amd64 only; on arm64 its script prints a notice and fetches nothing.
RUN python3 /opt/orpheum/scripts/fetch_ffmpeg.py \
 && python3 /opt/orpheum/scripts/fetch_mkvtoolnix.py \
 && mkdir -p /opt/orpheum/tools/mkvtoolnix
# The gate tools, linked from /opt/orpheum/tools/bin, which the Makefile puts on PATH. A layer of
# its own, so a changed pin fetches only them again.
COPY scripts/fetch_tools.py /opt/orpheum/scripts/
RUN python3 /opt/orpheum/scripts/fetch_tools.py

# ---------------------------------------------------------------------------------------------
# A local build of FFmpeg, in place of the pinned one, when ./staging is given ORPHEUM_FFMPEG_LOCAL
# (scripts/fetch_ffmpeg.py): it names the directory as this stage's build context. Empty otherwise.
FROM scratch AS ffmpeg-local

FROM ${DEBIAN_IMAGE} AS base
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV ORPHEUM_TOOLS_DIR=/opt/orpheum/tools
COPY --from=fetch /opt/orpheum/tools/ffmpeg /opt/orpheum/tools/ffmpeg

# ---------------------------------------------------------------------------------------------
FROM base AS toolchain

# gcc and libc6-dev: cgo, which the race detector needs. xz-utils: Node's archive. git: the
# commit a build records. python3: the gate scripts and the Makefile's.
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends \
      bash curl gcc git libc6-dev make procps python3 xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Go: the version go.mod's `toolchain` line names, read from go.mod here so it is written nowhere
# else. Each checksum is a sha256sum line naming the archive it is for, with the SHA-256 go.dev/dl
# publishes; a toolchain bump without new checksums stops the build here and fails
# test_dev_image.py. GOTOOLCHAIN=local keeps Go from fetching another toolchain behind the pin.
ARG GO_SHA256_AMD64="ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5  go1.26.10.linux-amd64.tar.gz"
ARG GO_SHA256_ARM64="3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797  go1.26.10.linux-arm64.tar.gz"
COPY go.mod /opt/orpheum/src/go.mod
RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) sum="$GO_SHA256_AMD64" ;; arm64) sum="$GO_SHA256_ARM64" ;; \
      *) echo "no pinned Go for $arch" >&2; exit 1 ;; \
    esac; \
    version="$(sed -n 's/^toolchain go//p' /opt/orpheum/src/go.mod)"; \
    [ -n "$version" ] || { echo "go.mod has no toolchain line to take Go's version from" >&2; exit 1; }; \
    archive="go${version}.linux-${arch}.tar.gz"; \
    [ "${sum##* }" = "$archive" ] || { \
      echo "go.mod wants $archive; the Containerfile's checksum is for ${sum##* }" >&2; exit 1; }; \
    curl -fsSL -o "/tmp/$archive" "https://go.dev/dl/$archive"; \
    (cd /tmp && echo "$sum" | sha256sum -c -); \
    tar -C /usr/local -xzf "/tmp/$archive"; rm "/tmp/$archive"
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local

# Node: the newest 22.x on 2026-09-30 (the Makefile pins the major only), with the SHA-256 from
# nodejs.org's SHASUMS256.txt.
ARG NODE_VERSION=22.23.4
ARG NODE_SHA256_AMD64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
ARG NODE_SHA256_ARM64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b
RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch=x64; sum="$NODE_SHA256_AMD64" ;; arm64) node_arch=arm64; sum="$NODE_SHA256_ARM64" ;; \
      *) echo "no pinned Node for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/node.tar.xz \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    echo "$sum  /tmp/node.tar.xz" | sha256sum -c -; \
    mkdir -p /opt/node; tar -C /opt/node --strip-components=1 -xJf /tmp/node.tar.xz; rm /tmp/node.tar.xz
ENV PATH=/opt/node/bin:$PATH

# ---------------------------------------------------------------------------------------------
FROM toolchain AS dev

# shellcheck: `make check-scripts`. iproute2's tc: `make test-acceptance` shapes the container's
# loopback with netem (D252 §1), as the developer, by the file capability set here; `./dev` gives
# the container the right to (NET_ADMIN), which no other step uses.
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends shellcheck iproute2 libcap2-bin \
 && setcap cap_net_admin+ep "$(command -v tc)" \
 && rm -rf /var/lib/apt/lists/*

COPY --from=fetch /opt/orpheum/tools/mkvtoolnix /opt/orpheum/tools/mkvtoolnix

# Playwright's system libraries, installed by the pinned Playwright itself: the playwright-core
# tarball web/package-lock.json resolves, checked against the lockfile's sha512 integrity. The
# browsers are not baked in: `make browsers` fetches them into a volume (Playwright fetches them
# for its own version over HTTPS; nothing here checks their hashes, as nothing does today).
COPY web/package-lock.json /opt/orpheum/src/web/package-lock.json
RUN set -eu; \
    python3 -c 'import json; p = json.load(open("/opt/orpheum/src/web/package-lock.json"))["packages"]["node_modules/playwright-core"]; print(p["resolved"], p["integrity"])' > /tmp/playwright.pin; \
    read -r url integrity < /tmp/playwright.pin; \
    curl -fsSL -o /tmp/playwright-core.tgz "$url"; \
    got="$(python3 -c 'import base64, hashlib, sys; print("sha512-" + base64.b64encode(hashlib.sha512(open(sys.argv[1], "rb").read()).digest()).decode())' /tmp/playwright-core.tgz)"; \
    [ "$got" = "$integrity" ] || { echo "playwright-core: integrity is $got, the lockfile says $integrity" >&2; exit 1; }; \
    mkdir /tmp/playwright-core; tar -C /tmp/playwright-core -xzf /tmp/playwright-core.tgz; \
    node /tmp/playwright-core/package/cli.js install-deps chromium firefox; \
    rm -rf /tmp/playwright* /var/lib/apt/lists/*

# The gate tools, last of the tools, so a changed pin rebuilds nothing above. Their links are on
# every shell's PATH, as the Makefile puts them on its own, so `golangci-lint` typed in `./dev`
# is the pinned one.
COPY --from=fetch /opt/orpheum/tools/golangci-lint /opt/orpheum/tools/golangci-lint
COPY --from=fetch /opt/orpheum/tools/sqlc /opt/orpheum/tools/sqlc
COPY --from=fetch /opt/orpheum/tools/bin /opt/orpheum/tools/bin
ENV PATH=/opt/orpheum/tools/bin:$PATH

# The developer: the host's uid and gid (`./dev` passes them), so the repository's files stay
# theirs. Their caches live in named volumes mounted over these directories; a new volume takes
# the directory's owner from here.
ARG DEV_UID=1000
ARG DEV_GID=1000
RUN set -eu; \
    getent group "$DEV_GID" >/dev/null || groupadd --gid "$DEV_GID" dev; \
    useradd --uid "$DEV_UID" --gid "$DEV_GID" --create-home --home-dir /home/dev --shell /bin/bash dev; \
    mkdir -p /home/dev/go /home/dev/.cache /home/dev/.npm; \
    chown -R "$DEV_UID:$DEV_GID" /home/dev
USER dev
# ORPHEUM_IN_DEV_IMAGE tells the git and Claude Code hooks they are inside this image, where the
# gate runs directly rather than through `./dev` (scripts/run_gate.py).
ENV HOME=/home/dev GOPATH=/home/dev/go ORPHEUM_IN_DEV_IMAGE=1
WORKDIR /home/dev

# ---------------------------------------------------------------------------------------------
FROM toolchain AS build
# The repository, as .dockerignore trims it, and `make build`, the one way the binary is built:
# the web apps, then the binary with the web client in it. npm's and Go's caches persist between
# builds in BuildKit's cache, so an update builds only what changed.
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/go/pkg/mod \
    git config --global --add safe.directory /src \
 && make build

# ---------------------------------------------------------------------------------------------
FROM base AS runtime
# wireguard-tools and iproute2: orpheum-tunnel, the core's end of the tunnel to the VPS (D249 §2).
# On amd64, Intel's GPU runtime and VA driver, which the portable FFmpeg loads from the system for
# Quick Sync; without them every QSV encode fails with "Error creating a MFX session: -9" (the production NAS,
# 2026-10-20). The non-free driver is the one with every encoder the GPU has (the owner,
# 2026-10-20). Mesa's VA drivers, for an AMD card's encodes through VAAPI (D332); they bring LLVM,
# about 100 MB.
RUN set -eu; packages="iproute2 wireguard-tools"; \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources; \
      packages="$packages libmfx-gen1.2 intel-media-va-driver-non-free mesa-va-drivers"; \
    fi; \
    apt-get update -q \
 && apt-get install -y -q --no-install-recommends $packages \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/bin/orpheum /usr/local/bin/orpheum
COPY deploy/staging/tunnel.sh /usr/local/bin/orpheum-tunnel
# The pinned FFmpeg, or the local build given in its place, at a path that names no version or
# architecture, for the node's ffmpeg_dir.
COPY --from=ffmpeg-local / /opt/orpheum/ffmpeg-local/
RUN if [ -x /opt/orpheum/ffmpeg-local/ffmpeg ]; then ln -s /opt/orpheum/ffmpeg-local /opt/orpheum/ffmpeg; \
    else ln -s "$(find /opt/orpheum/tools/ffmpeg -mindepth 1 -maxdepth 1 -type d)" /opt/orpheum/ffmpeg; fi \
 && test -x /opt/orpheum/ffmpeg/ffmpeg
# The user the core and the node run as when compose names none; staging names the host's own, so
# the files it writes in its directory are the owner's (internal/deployment/templates/compose.yaml).
RUN useradd --uid 10001 --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin orpheum
USER orpheum
ENTRYPOINT ["/usr/local/bin/orpheum"]
