# ABOUTME: Staging (D249 §3): builds the runtime image from this checkout and runs the deployment
# ABOUTME: (deploy/compose.yaml) beside the dev loop, with its own data outside the checkout.
"""Run Orpheum's staging deployment on this machine, from this checkout (D249, D272 §3).

    ./staging             build the image from the checkout, write the deployment into staging's directory
                          with the image's own write-deployment, and start or restart it, keeping the
                          run it replaces' logs in its logs/
    ./staging quick       the same, the image only the last full one with this checkout's binary and
                          tunnel script laid over it, the binary built in ./dev's warm caches: a
                          minute in place of several, for trying a fix live; a change to anything
                          else the image holds (FFmpeg, the system's packages) needs the full one
    ./staging logs        follow the three services' logs
    ./staging status      show the services and whether they are healthy
    ./staging setup-code  print the one-time code that makes the first admin
    ./staging down        stop staging (its data stays)
    ./staging wipe        stop staging and delete its data: the database, the caches, the instances
                          (the values file and the tunnel's keys stay)

Staging's directory is outside the checkout, where a sandbox reset cannot delete it:
ORPHEUM_STAGING_DIR, else $XDG_STATE_HOME/orpheum-staging (~/.local/state/orpheum-staging). Below it is
"staging's directory".

Staging runs on another machine when staging's directory's remote.toml names it (the staging host since 2026-11-01, so
the gate has this machine's processors to itself):

    host = "orpheum@staging.example"        # ssh's destination; the user must be in the docker group
    identity = "~/.ssh/<staging key>"               # ssh's key, if not its default
    directory = "/home/orpheum/orpheum-staging"  # staging's directory there

The image is built here and sent with `docker save | ssh docker load`; write-deployment and compose
run there, over ssh, as the remote user, and every other command above runs there too. The run it
replaces' logs are still kept here, in staging's directory's logs/.

Staging is written exactly as release is, by the image's `orpheum write-deployment`, so the one path
stays tested; only the image differs, built here rather than from a tag. The first run makes
staging's directory, writes its values file and the tunnel's key pair, and says what to fill in.

An executable after-up in staging's directory runs after each deploy, here, from the checkout: what else serves this
checkout and must follow it, such as a loader's copy of the web client.

It needs Docker with the compose plugin and BuildKit, and a kernel with WireGuard. It never touches
the dev loop's container or .dev/. Stdlib only, as ./dev is.
"""

from __future__ import annotations

import os
import shutil
import socket
import subprocess
import sys
import tempfile
import shlex
import tomllib
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "scripts"))
import fetch_ffmpeg  # noqa: E402

def state_directory(environ: "os._Environ[str] | dict[str, str]" = os.environ) -> Path:
    """Staging's own directory, outside the checkout: a sandbox reset replaces the checkout and deletes
    what git does not track in it (agent-failures A71; the owner, 2026-11-12). ORPHEUM_STAGING_DIR
    names it, else the XDG state directory's orpheum-staging."""
    if environ.get("ORPHEUM_STAGING_DIR"):
        return Path(environ["ORPHEUM_STAGING_DIR"]).expanduser()
    state = Path(environ["XDG_STATE_HOME"]) if environ.get("XDG_STATE_HOME") else Path.home() / ".local" / "state"
    return state / "orpheum-staging"


DIR = state_directory()
# Where staging's directory was until 2026-11-12 (state_directory).
CHECKOUT_DIR = ROOT / ".staging"
CONTAINERFILE = ROOT / "deploy" / "Containerfile"
VALUES = DIR / "values.toml"
# Each deploy keeps the run it replaces here, since recreating a container drops its logs.
LOGS = DIR / "logs"
IMAGE = "orpheum-runtime:staging"
# The last image built in full, which `./staging quick` lays a new binary over: over IMAGE, each
# quick build would pile its layer on the last one's.
FULL_IMAGE = "orpheum-runtime:staging-full"
# Where the runtime image keeps the binary and the tunnel script (deploy/Containerfile's runtime stage).
BINARY_IN_IMAGE = "/usr/local/bin/orpheum"
TUNNEL_IN_IMAGE = "/usr/local/bin/orpheum-tunnel"
TUNNEL = ROOT / "deploy" / "staging" / "tunnel.sh"
# Run after each deploy, from the checkout, when the staging directory holds it (after_up).
AFTER_UP = "after-up"
# Where write-deployment sees the deployment's directory and its run directory (cmd/orpheum's
# deploymentMount and deploymentRun), and where the core's instance is in its container.
MOUNT = "/var/lib/orpheum"
RUN_MOUNT = "/run/orpheum"
CORE_INSTANCE = MOUNT + "/core"
RENDER_DEVICES = Path("/dev/dri")
# What staging's directory held before write-deployment wrote it (D249, until 2026-10-09): the
# values file under its old name, and the media override compose no longer reads.
OLD_VALUES = DIR / "staging.toml"
OLD_OVERRIDE = DIR / "compose.media.yaml"
# Names the machine staging runs on when it is not this one (the module's docstring).
REMOTE = DIR / "remote.toml"


@dataclass(frozen=True)
class Target:
    """Where staging runs: this machine, or another reached by ssh (REMOTE)."""
    directory: Path
    host: str | None = None
    identity: str | None = None

    def command(self, argv: list[str]) -> list[str]:
        """argv as run where staging runs: itself here, or one ssh command line there."""
        if self.host is None:
            return argv
        key = ["-i", os.path.expanduser(self.identity)] if self.identity else []
        return ["ssh", "-o", "BatchMode=yes", *key, self.host, shlex.join(argv)]

    def compose(self, *args: str) -> list[str]:
        """A compose command on staging's directory, which holds its compose file, .env and override."""
        return self.command(["docker", "compose", "--project-directory", str(self.directory), *args])


LOCAL = Target(DIR)


def load_target(text: str | None) -> Target:
    """The target REMOTE's text names, or this machine when there is none. A remote directory must be
    absolute: Docker mounts it, and ssh's command line does not expand ~."""
    if text is None:
        return LOCAL
    remote = tomllib.loads(text)
    host, directory = remote.get("host"), remote.get("directory", "")
    if not host or not os.path.isabs(directory):
        raise SystemExit(f"staging: {REMOTE} needs host and an absolute directory")
    return Target(Path(directory), host, remote.get("identity"))


def run(command: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(command, check=True, **kwargs)


def compose(*args: str) -> list[str]:
    """A compose command on this machine's staging directory."""
    return LOCAL.compose(*args)


def lan_address() -> str:
    """This machine's address on the LAN: the source address of its default route."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
            probe.connect(("192.0.2.1", 9))  # sends nothing; only picks the route
            return probe.getsockname()[0]
    except OSError:
        return "this-machine"


def left_in_checkout(old: Path, new: Path) -> str | None:
    """What to do when staging's directory is still in the checkout and not yet where it now lives,
    or None. Not moved for you: a staging running here has its data mounted from the old place."""
    if not old.is_dir() or new.exists():
        return None
    stop = "stop it (./staging down) if it runs on this machine, then " if (old / "compose.yaml").exists() else ""
    return f"staging: its directory is still in the checkout, {old}; {stop}move it: mv {old} {new}"


def adopt_old_layout() -> bool:
    """Bring a staging directory from before write-deployment forward: its values file gains the
    deployment's kind under its new name, and the old override goes. Reports whether it did."""
    if not OLD_VALUES.exists() or VALUES.exists():
        return False
    VALUES.write_text('deployment = "staging"\n' + OLD_VALUES.read_text())
    OLD_VALUES.unlink()
    OLD_OVERRIDE.unlink(missing_ok=True)
    return True


def missing_media(values_text: str, is_dir=os.path.isdir) -> list[str]:
    """The values file's media roots that are not directories where staging runs, as is_dir says."""
    try:
        roots = tomllib.loads(values_text).get("media", {}).get("roots", [])
    except tomllib.TOMLDecodeError:
        return []  # write-deployment says what is wrong with it
    return [str(root) for root in roots if os.path.isabs(str(root)) and not is_dir(str(root))]


def remote_is_dir(target: Target):
    """is_dir for missing_media, asked of the target's machine."""
    return lambda path: subprocess.run(target.command(["test", "-d", path]), check=False).returncode == 0


@dataclass(frozen=True)
class Machine:
    """What write-deployment needs to know of the machine staging runs on."""
    uid: int
    gid: int
    host_name: str
    has_gpu: bool


def remote_machine(target: Target) -> Machine:
    """The remote user's IDs, the machine's name and whether it has a GPU, in one ssh call."""
    said = subprocess.run(target.command(["sh", "-c", "echo $(id -u) $(id -g) $(hostname) "
                                          f"$(test -d {RENDER_DEVICES} && echo gpu)"]),
                          capture_output=True, text=True, check=True).stdout.split()
    return Machine(int(said[0]), int(said[1]), said[2], said[3:] == ["gpu"])


def send_image(image: str, target: Target) -> None:
    """docker save here, piped into docker load there: the image is built where the checkout is."""
    print(f"staging: sending the image to {target.host}", flush=True)
    saved = subprocess.Popen(["docker", "save", IMAGE], stdout=subprocess.PIPE)
    loaded = subprocess.run(target.command(["docker", "load", "--quiet"]), stdin=saved.stdout, check=False)
    saved.stdout.close()
    if saved.wait() != 0 or loaded.returncode != 0:
        raise subprocess.CalledProcessError(loaded.returncode or saved.returncode, ["docker", "save", image])


def save_logs(now: datetime, target: Target = LOCAL) -> Path | None:
    """Keep the running services' logs in LOGS before a deploy replaces them, which drops their logs:
    a test's log was lost to the deploy of its fix (2026-10-06). Returns the file, or None when
    nothing ran."""
    logs = subprocess.run(target.compose("logs", "--no-color", "--timestamps"), capture_output=True, text=True,
                          check=False).stdout
    if not logs.strip():
        return None
    LOGS.mkdir(parents=True, exist_ok=True)
    saved = LOGS / f"{now.astimezone(timezone.utc).strftime('%Y-%m-%dT%H-%M-%SZ')}.log"
    saved.write_text(logs)
    return saved


def build_image() -> str:
    """Build the runtime image from the checkout, and return its ID. ORPHEUM_FFMPEG_LOCAL, when set,
    is a local build of FFmpeg the image carries in place of the pinned one (scripts/fetch_ffmpeg.py);
    a quick build keeps whichever the last full one carried."""
    # The binary from ./dev's own warm caches, in place of the Containerfile's build stage (BuildKit
    # takes a named context for the stage of that name): built from source in BuildKit's third set of
    # Go and npm caches, a full build waited minutes for what ./dev had just compiled. The release
    # build (make deploy) keeps the stage. The owner, 2026-10-28: "If there's a real problem,
    # deploying will make it show" (the caching audit's finding 7).
    print("staging: building the binary in ./dev", flush=True)
    run([str(ROOT / "dev"), "make", "build"])
    print(f"staging: building {IMAGE} from this checkout around it", flush=True)
    local = fetch_ffmpeg.local_build()
    context = ["--build-context", f"ffmpeg-local={local}"] if local is not None else []
    with tempfile.TemporaryDirectory() as built:
        # Where the build stage leaves it, which the runtime stage copies from.
        (Path(built) / "src" / "bin").mkdir(parents=True)
        shutil.copy2(ROOT / "bin" / "orpheum", Path(built) / "src" / "bin" / "orpheum")
        run(["docker", "build", "--file", str(CONTAINERFILE), "--target", "runtime", "--tag", IMAGE,
             "--tag", FULL_IMAGE, "--build-context", f"build={built}", *context, str(ROOT)],
            env={**os.environ, "DOCKER_BUILDKIT": "1"})
    return image_id(IMAGE)


def image_id(name: str) -> str | None:
    """An image's ID, or None when there is no such image."""
    inspected = subprocess.run(["docker", "image", "inspect", "--format", "{{.Id}}", name], capture_output=True,
                               text=True, check=False)
    return inspected.stdout.strip() if inspected.returncode == 0 else None


def quick_containerfile(full_image: str) -> str:
    """The quick image: the full one, named by its tag (BuildKit pulls an image named by a bare ID),
    with the binary and the tunnel script where the runtime stage puts them."""
    return (f"FROM {full_image}\n"
            f"COPY orpheum {BINARY_IN_IMAGE}\n"
            f"COPY tunnel.sh {TUNNEL_IN_IMAGE}\n")


def quick_image() -> str | None:
    """Build the binary in ./dev, lay it over the last full image, and return the new image's ID;
    None, having said why, when there is no full image to lay it over."""
    if image_id(FULL_IMAGE) is None:
        print(f"staging: no {FULL_IMAGE} to lay the binary over; run ./staging once first", file=sys.stderr)
        return None
    print("staging: building the binary in ./dev", flush=True)
    run([str(ROOT / "dev"), "make", "build"])
    print(f"staging: laying it over {FULL_IMAGE}", flush=True)
    with tempfile.TemporaryDirectory() as context:
        shutil.copy2(ROOT / "bin" / "orpheum", Path(context) / "orpheum")
        shutil.copy2(TUNNEL, Path(context) / "tunnel.sh")
        run(["docker", "build", "--tag", IMAGE, "--file", "-", context], input=quick_containerfile(FULL_IMAGE),
            text=True, env={**os.environ, "DOCKER_BUILDKIT": "1"})
    return image_id(IMAGE)


def write_deployment_command(image: str, uid: int, gid: int, host_name: str, has_gpu: bool,
                             directory: Path = DIR) -> list[str]:
    """The image's write-deployment over staging's directory, as cmd/orpheum's usage says to run it.
    The .env file names the image by its ID: by its tag alone, compose saw no change and kept the old
    containers running."""
    devices = ["--volume", f"{RENDER_DEVICES}:{RENDER_DEVICES}:ro"] if has_gpu else []
    return ["docker", "run", "--rm", "--user", f"{uid}:{gid}", "--hostname", host_name,
            "--volume", f"{directory}:{MOUNT}", "--volume", f"{directory / 'run'}:{RUN_MOUNT}", *devices,
            image, "write-deployment", "--deployment", "staging", "--image", image]


# What Docker's build cache keeps after a build: each full build added a layer of the checkout, and
# the cache grew until the disk was full (the disk-full review, 2026-10-28).
BUILD_CACHE_KEPT = "5GB"


def prune_builds() -> None:
    """Trims Docker's build cache to BUILD_CACHE_KEPT, and drops the images no tag names any more:
    each build leaves the one it replaced. The tagged ones, staging's and its rollback points, stay."""
    subprocess.run(["docker", "builder", "prune", "--force", "--max-used-space", BUILD_CACHE_KEPT],
                   check=False, stdout=subprocess.DEVNULL)
    subprocess.run(["docker", "image", "prune", "--force"], check=False, stdout=subprocess.DEVNULL)


def values_text(target: Target) -> str | None:
    """Staging's values file where it runs, or None before the first run wrote it."""
    if target.host is None:
        return VALUES.read_text() if VALUES.exists() else None
    read = subprocess.run(target.command(["cat", str(target.directory / VALUES.name)]), capture_output=True,
                          text=True, check=False)
    return read.stdout if read.returncode == 0 else None


def up(quick: bool = False, target: Target = LOCAL) -> int:
    # The disk first: a build that fills it fails part-way, saying something else (scripts/disk_guard.py).
    if subprocess.run([sys.executable, str(ROOT / "scripts" / "disk_guard.py")], check=False).returncode != 0:
        return 1
    DIR.mkdir(parents=True, exist_ok=True)
    if target.host is None:
        (DIR / "run").mkdir(exist_ok=True)
        if adopt_old_layout():
            print(f"staging: moved the values file to {VALUES}", flush=True)
        machine = Machine(os.getuid(), os.getgid(), socket.gethostname(), RENDER_DEVICES.is_dir())
        is_dir = os.path.isdir
    else:
        run(target.command(["mkdir", "-p", str(target.directory / "run")]))
        machine = remote_machine(target)
        is_dir = remote_is_dir(target)
    values = values_text(target)
    if values is not None and (missing := missing_media(values, is_dir)):
        print("staging: " + ", ".join(f'media.roots "{root}": no such directory where staging runs'
                                       for root in missing), file=sys.stderr)
        return 1
    image = quick_image() if quick else build_image()
    prune_builds()
    if image is None:
        return 1
    if target.host is not None:
        send_image(image, target)
        # Each image sent leaves the one it replaced there, as each build does here.
        subprocess.run(target.command(["docker", "image", "prune", "--force"]), check=False,
                       stdout=subprocess.DEVNULL)
    written = subprocess.run(target.command(write_deployment_command(
        image, machine.uid, machine.gid, machine.host_name, machine.has_gpu, target.directory)), check=False)
    if written.returncode != 0:
        return 1
    saved = save_logs(datetime.now(timezone.utc), target)
    if saved is not None:
        print(f"staging: kept the last run's logs in {saved}", flush=True)
    # Recreated every time: a tunnel container restarted on its own leaves the core outside its
    # network, and recreating both is what mends it (the compose file).
    run(target.compose("up", "--detach", "--remove-orphans", "--force-recreate", "--wait"))
    print(where_reached(tomllib.loads(values_text(target) or ""),
                        lan_address() if target.host is None else target.host.rpartition("@")[2]))
    return after_up(DIR)


def after_up(directory: Path) -> int:
    """Runs the staging directory's after-up, when there is one: what else serves this checkout and
    must follow each deploy, such as a loader's copy of the web client (the owner's Chromecast ran the
    old receiver from the loader's copy after a deploy here, 2026-11-12). This machine's own, so the
    directory holds it, not the repository."""
    hook = directory / AFTER_UP
    if not os.access(hook, os.X_OK):
        return 0
    print(f"staging: running {hook}", flush=True)
    done = subprocess.run([str(hook)], cwd=ROOT, check=False)
    if done.returncode != 0:
        print(f"staging: {hook} failed ({done.returncode}); staging itself is up", file=sys.stderr)
    return done.returncode


def where_reached(values: dict, this_machine: str) -> str:
    """Where staging is reached, as its values file says: at home by the address it names, which a
    machine inside a container cannot see for itself (it printed the sandbox's own Docker address,
    2026-10-23), and from outside by its name, or through its discovery when it has none."""
    http = values.get("http", {})
    host = values.get("lan", {}).get("address") or this_machine
    if http.get("publish") == "127.0.0.1":
        host = "127.0.0.1"
    domain = values.get("domain")
    if domain:
        outside = (f"https://{domain}  (once its certificate is issued: enter the DNS token in Settings,\n"
                   "                           Keys and passwords, as dns_provider_token)")
    else:
        outside = "through its discovery, once it is claimed (orpheum-ops, staging/README.md)"
    return f"""
staging: up.
  On the house's network:  http://{host}:{http.get("port", 8440)}
  From outside:            {outside}
  A new server's first admin:  ./staging setup-code
  Logs:                        ./staging logs"""


def wipe(target: Target = LOCAL) -> int:
    where = target.directory if target.host is None else f"{target.host}:{target.directory}"
    answer = input(f"staging: delete the database, caches and instances in {where}? Type wipe to confirm: ")
    if answer.strip() != "wipe":
        print("staging: nothing deleted")
        return 1
    if target.host is not None:
        subprocess.run(target.compose("down", "--remove-orphans"), check=False)
        run(target.command(["rm", "-rf", *(str(target.directory / name) for name in ("core", "node", "run"))]))
    else:
        if (DIR / "compose.yaml").exists():
            run(compose("down", "--remove-orphans"))
        for name in ("core", "node", "run"):
            shutil.rmtree(DIR / name, ignore_errors=True)
    print("staging: wiped; the values file and the tunnel's keys stay. ./staging starts a new one.")
    return 0


def main(argv: list[str]) -> int:
    command = argv[0] if argv else "up"
    if shutil.which("docker") is None:
        print("staging: needs Docker with the compose plugin (https://docs.docker.com/engine/install/)",
              file=sys.stderr)
        return 1
    if (left := left_in_checkout(CHECKOUT_DIR, DIR)) is not None:
        print(left, file=sys.stderr)
        return 1
    target = load_target(REMOTE.read_text() if REMOTE.exists() else None)
    if command in ("up", "quick"):
        return up(quick=command == "quick", target=target)
    if command == "wipe":
        return wipe(target)
    passthrough = {"logs": ("logs", "--follow", "--tail", "200"), "status": ("ps",), "down": ("down",),
                   "setup-code": ("exec", "-T", "orpheum-core", "orpheum", "setup-code", "--instance", CORE_INSTANCE)}
    if command not in passthrough:
        print(__doc__, file=sys.stderr)
        return 2
    if target.host is None and not (DIR / "compose.yaml").exists():
        print("staging: not written yet; run ./staging first", file=sys.stderr)
        return 1
    return subprocess.run(target.compose(*passthrough[command]), check=False).returncode


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except subprocess.CalledProcessError as failed:
        print(f"staging: {' '.join(failed.cmd[:3])}... failed with status {failed.returncode}", file=sys.stderr)
        sys.exit(1)
