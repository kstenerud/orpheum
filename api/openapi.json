{
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "hop": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "status": {
            "enum": [
              "starting",
              "migrating",
              "ready",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "reasons"
        ],
        "type": "object"
      },
      "PutSecretInputBody": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "PutSettingsInputBody": {
        "additionalProperties": false,
        "properties": {
          "values": {
            "additionalProperties": {},
            "description": "Setting keys and their new JSON values",
            "type": "object"
          }
        },
        "required": [
          "values"
        ],
        "type": "object"
      },
      "SecretBody": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "hint": {
            "description": "The last four characters of an API key",
            "type": "string"
          },
          "isSet": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "needsReentry": {
            "description": "Sealed under a key this server no longer has",
            "type": "boolean"
          },
          "setAt": {
            "format": "int64",
            "type": "integer"
          },
          "setBy": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "description",
          "isSet",
          "needsReentry"
        ],
        "type": "object"
      },
      "SecretsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "secrets": {
            "items": {
              "$ref": "#/components/schemas/SecretBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "secrets"
        ],
        "type": "object"
      },
      "SeedOutputBody": {
        "additionalProperties": false,
        "properties": {
          "written": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "written"
        ],
        "type": "object"
      },
      "SessionOutputBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserBody"
          }
        },
        "required": [
          "token",
          "user"
        ],
        "type": "object"
      },
      "SettingBody": {
        "additionalProperties": false,
        "properties": {
          "describe": {
            "type": "string"
          },
          "isExposed": {
            "description": "Shown on the settings page; every setting is in /config",
            "type": "boolean"
          },
          "isModified": {
            "type": "boolean"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "bool",
              "integer",
              "string"
            ],
            "type": "string"
          },
          "maximum": {
            "format": "int64",
            "type": "integer"
          },
          "minimum": {
            "format": "int64",
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "setAt": {
            "format": "int64",
            "type": "integer"
          },
          "setBy": {
            "format": "int64",
            "type": "integer"
          },
          "start": {
            "description": "The value a new server starts with",
            "type": [
              "",
              "null"
            ]
          },
          "value": {
            "type": [
              "",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "kind",
          "value",
          "start",
          "isModified",
          "describe",
          "isExposed",
          "setAt"
        ],
        "type": "object"
      },
      "SettingsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "settings": {
            "items": {
              "$ref": "#/components/schemas/SettingBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "settings"
        ],
        "type": "object"
      },
      "SetupInputBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "setupCode": {
            "description": "The one-time code the server logged at start",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "setupCode",
          "name",
          "password"
        ],
        "type": "object"
      },
      "SignInInputBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "password"
        ],
        "type": "object"
      },
      "UserBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "isOutsider": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "user"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "isAdmin",
          "isOutsider"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The Orpheum media server's client API (cut-a §5). Errors have one shape: {\"error\": {\"code\", \"message\", \"detail\", \"hop\"}}.",
    "title": "Orpheum",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/config": {
      "get": {
        "operationId": "getConfig",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          },
          {
            "description": "Only the settings whose value differs from the value a new server starts with",
            "explode": false,
            "in": "query",
            "name": "modified",
            "schema": {
              "description": "Only the settings whose value differs from the value a new server starts with",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Every server setting, with its starting value and whether it was changed; ?modified=true lists only the changed ones (admin)",
        "tags": [
          "Settings"
        ]
      },
      "put": {
        "operationId": "putConfig",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutSettingsInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change any server settings, all or none (admin)",
        "tags": [
          "Settings"
        ]
      }
    },
