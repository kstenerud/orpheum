{
  "components": {
    "schemas": {
      "CandidateBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "posterRef": {
            "description": "The provider's path for the poster",
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "year": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "providerId",
          "name"
        ],
        "type": "object"
      },
      "CandidatesOutputBody": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateBody"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "candidates"
        ],
        "type": "object"
      },
      "ConfigFileKey": {
        "additionalProperties": false,
        "properties": {
          "describe": {
            "type": "string"
          },
          "isFromFile": {
            "description": "False when the file lacks it: it runs on its starting value",
            "type": "boolean"
          },
          "key": {
            "type": "string"
          },
          "start": {
            "description": "The starting value; null when the key has none",
            "type": [
              "",
              "null"
            ]
          },
          "value": {}
        },
        "required": [
          "key",
          "value",
          "start",
          "isFromFile",
          "describe"
        ],
        "type": "object"
      },
      "ConfigOutputBody": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "items": {
              "$ref": "#/components/schemas/ConfigFileKey"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "settings": {
            "items": {
              "$ref": "#/components/schemas/SettingBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "settings",
          "file"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "hop": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "status": {
            "enum": [
              "starting",
              "migrating",
              "ready",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "reasons"
        ],
        "type": "object"
      },
      "MatchInputBody": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "examples": [
              "tmdb"
            ],
            "type": "string"
          },
          "providerId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "provider",
          "providerId"
        ],
        "type": "object"
      },
      "PutOverrideInputBody": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "description": "The value; year and runtime (milliseconds) are whole numbers",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "PutSecretInputBody": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "PutSettingsInputBody": {
        "additionalProperties": false,
        "properties": {
          "values": {
            "additionalProperties": {},
            "description": "Setting keys and their new JSON values",
            "type": "object"
          }
        },
        "required": [
          "values"
        ],
        "type": "object"
      },
      "SecretBody": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "hint": {
            "description": "The last four characters of an API key",
            "type": "string"
          },
          "isSet": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "needsReentry": {
            "description": "Sealed under a key this server no longer has",
            "type": "boolean"
          },
          "setAt": {
            "format": "int64",
            "type": "integer"
          },
          "setBy": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "description",
          "isSet",
          "needsReentry"
        ],
        "type": "object"
      },
      "SecretsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "secrets": {
            "items": {
              "$ref": "#/components/schemas/SecretBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "secrets"
        ],
        "type": "object"
      },
      "SessionOutputBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserBody"
          }
        },
        "required": [
          "token",
          "user"
        ],
        "type": "object"
      },
      "SettingBody": {
        "additionalProperties": false,
        "properties": {
          "describe": {
            "type": "string"
          },
          "isExposed": {
            "description": "Shown on the settings page; every setting is in /config",
            "type": "boolean"
          },
          "isModified": {
            "type": "boolean"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "bool",
              "integer",
              "string"
            ],
            "type": "string"
          },
          "maximum": {
            "format": "int64",
            "type": "integer"
          },
          "minimum": {
            "format": "int64",
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "setAt": {
            "format": "int64",
            "type": "integer"
          },
          "setBy": {
            "format": "int64",
            "type": "integer"
          },
          "start": {
            "description": "The value a new server starts with",
            "type": [
              "",
              "null"
            ]
          },
          "value": {
            "type": [
              "",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "kind",
          "value",
          "start",
          "isModified",
          "describe",
          "isExposed",
          "setAt"
        ],
        "type": "object"
      },
      "SettingsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "settings": {
            "items": {
              "$ref": "#/components/schemas/SettingBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "settings"
        ],
        "type": "object"
      },
      "SetupInputBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "setupCode": {
            "description": "The one-time code the server logged at start",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "setupCode",
          "name",
          "password"
        ],
        "type": "object"
      },
      "SignInInputBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "password"
        ],
        "type": "object"
      },
      "TitleBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "ident": {
            "enum": [
              "identified",
              "ambiguous",
              "unidentified",
              "confirmed"
            ],
            "type": "string"
          },
          "kind": {
            "enum": [
              "movie",
              "episode",
              "extra"
            ],
            "type": "string"
          },
          "libraryId": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "description": "The source the title follows: nfo, tmdb, or none",
            "type": "string"
          },
          "sourceId": {
            "description": "The title's id at its source",
            "type": "string"
          },
          "year": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "libraryId",
          "kind",
          "name",
          "ident"
        ],
        "type": "object"
      },
      "TitlesOutputBody": {
        "additionalProperties": false,
        "properties": {
          "titles": {
            "items": {
              "$ref": "#/components/schemas/TitleBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "titles"
        ],
        "type": "object"
      },
      "UnusedBody": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "retiredIn": {
            "description": "The release that stopped reading it; empty for a typo",
            "type": "string"
          },
          "retiredWhy": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "server",
              "user"
            ],
            "type": "string"
          },
          "userId": {
            "format": "int64",
            "type": "integer"
          },
          "value": {}
        },
        "required": [
          "key",
          "scope",
          "value"
        ],
        "type": "object"
      },
      "UnusedOutputBody": {
        "additionalProperties": false,
        "properties": {
          "unused": {
            "items": {
              "$ref": "#/components/schemas/UnusedBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "unused"
        ],
        "type": "object"
      },
      "UserBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "isOutsider": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "user"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "isAdmin",
          "isOutsider"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The Orpheum media server's client API (cut-a §5). Errors have one shape: {\"error\": {\"code\", \"message\", \"detail\", \"hop\"}}.",
    "title": "Orpheum",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/config": {
      "get": {
        "operationId": "getConfig",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          },
          {
            "description": "Only the settings a person set, even to their starting value",
            "explode": false,
            "in": "query",
            "name": "modified",
            "schema": {
              "description": "Only the settings a person set, even to their starting value",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Every server setting beside its starting value, and the config file's keys (read-only); ?modified=true lists only the settings a person set (admin)",
        "tags": [
          "Settings"
        ]
      },
      "put": {
        "operationId": "putConfig",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutSettingsInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change any server settings, all or none (admin)",
        "tags": [
          "Settings"
        ]
      }
    },
    "/config/unused": {
      "get": {
        "operationId": "getUnusedConfig",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnusedOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Setting rows this release does not read: retired keys, or typos (admin)",
        "tags": [
          "Settings"
        ]
      }
    },
    "/config/unused/{key}": {
      "delete": {
        "operationId": "deleteUnusedConfig",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The user whose row it is; 0 or absent for a server row",
            "explode": false,
            "in": "query",
            "name": "user",
            "schema": {
              "description": "The user whose row it is; 0 or absent for a server row",
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Delete a setting row this release does not read; a setting in use is set to default instead (admin)",
        "tags": [
          "Settings"
        ]
      }
    },
    "/config/{key}/reset": {
      "post": {
        "operationId": "resetConfig",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Set a server setting to default: its starting value, no longer marked modified, so it follows its starting value when a release changes it (admin)",
        "tags": [
          "Settings"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Unauthenticated. Starting and migrating answer 200 so a container manager does not kill a busy server; degraded answers 503 with its reasons.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Whether the server is starting, migrating, ready or degraded",
        "tags": [
          "Running it"
        ]
      }
    },
    "/items/{id}/overrides/{field}": {
      "delete": {
        "operationId": "deleteOverride",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "field",
            "required": true,
            "schema": {
              "enum": [
                "name",
                "overview",
                "tagline",
                "year",
                "runtime"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Remove a field's override, so it follows its source again (edit_metadata)",
        "tags": [
          "Identification"
        ]
      },
      "put": {
        "operationId": "putOverride",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "field",
            "required": true,
            "schema": {
              "enum": [
                "name",
                "overview",
                "tagline",
                "year",
                "runtime"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutOverrideInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Set a field to a person's value, kept over every source (edit_metadata)",
        "tags": [
          "Identification"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Who this session belongs to",
        "tags": [
          "Setup and auth"
        ]
      }
    },
    "/me/secrets": {
      "get": {
        "operationId": "getMineSecrets",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Bearer \u003csession token\u003e",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecretsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Which secrets of this user are set; never their values",
        "tags": [
          "Settings"
        ]
      }
    },
    "/me/secrets/{name}": {
      "delete": {
        "operationId": "deleteMineSecret",
        "parameters": [
          {
            "description": "Bearer \u003csession token\u003e",
