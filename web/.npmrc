# SPDX-License-Identifier: MPL-2.0
# Exact versions only; a range lets a transitive update change behaviour without a diff.
save-exact=true
engine-strict=true
fund=false
audit=false
# No package runs a script at install: this week's malicious npm packages acted through
# postinstall, and lfa-ponyfill (pulled in by jassub) fetched Google Fonts' metadata at install and
# overwrote the fonts.json the client ships with it. With scripts off, every package is its tarball.
ignore-scripts=true
