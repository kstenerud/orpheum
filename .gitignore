# build and tool output
/bin/
# `go build ./cmd/orpheum` in the root writes the binary here
/orpheum
# `go build` in a command's folder writes its binary beside it (one was committed by mistake, 2026-11-01)
/cmd/discovery-sign/discovery-sign
/cmd/discovery-watch/discovery-watch
/cmd/orpheum/orpheum
/cmd/release-record/release-record
/.tools/
/.dev/
/dist/
*.test
*.out
coverage.*
# web
# no trailing slash: a node_modules symlink in a scratch worktree is ignored too
node_modules
web/**/dist/
web/**/.vite/
# local state
/.claude/.cache/
/.claude/settings.local.json
__pycache__/
*.pyc
# the built web client, copied in by `make build` (D216 §2); the placeholder keeps the directory
/internal/core/webclient/dist/*
!/internal/core/webclient/dist/.keep
/.staging/

# Worktrees an agent tool adds for isolated work: their own checkouts, not this one's files.
/.claude/worktrees/
