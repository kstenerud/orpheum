#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Runs the gate before a commit is recorded, so a human commit meets the same bar as an agent's.
# Installed by `make setup` (git config core.hooksPath .githooks).
set -euo pipefail
# The Stop hook runs the gate at the end of every turn; a commit of exactly the tree it passed on
# is not checked twice (scripts/check_stamp.py). Anything else runs the gate.
if python3 scripts/check_stamp.py fresh; then
  echo "make check: already passed on this exact tree"
  exit 0
fi
# A commit of documentation alone runs the documentation gate, no test of the code
# (scripts/documentation_only.py; the owner, 2026-10-08).
target=check
if python3 scripts/documentation_only.py --staged; then
  target=check-documentation
fi
# Where the tools are: here, or in the development image through ./dev (scripts/run_gate.py).
exec python3 scripts/run_gate.py "$target"
