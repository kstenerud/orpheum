root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,yml,yaml,toml,sql,py,sh,md}]
indent_style = space
indent_size = 2

[*.{py,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
